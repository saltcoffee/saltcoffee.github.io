---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.SEOTitle | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>zh-CN</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% include articles.html %}
    {% for post in articles limit:20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <description>{{ post.summary | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
      {% if post.date and post.date != site.time %}<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>{% endif %}
      <link>{{ post.url | absolute_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
      {% for tag in post.tags %}<category>{{ tag | xml_escape }}</category>{% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
